# Copy this file to .env and fill it in. Never commit .env.
NODE_ENV=production
PORT=3000
TZ=UTC
APP_URL=https://your-domain.example
GOOGLE_MODE=live                     # live | mock (mock needs no Google account: demo data only)
MOCK_FAIL=                           # dev/test only: calendar,drive,sheets429,network (add :N to fail only N times)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://your-domain.example/api/auth/google/callback
SESSION_SECRET=                      # 32+ random characters: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=                # 32 bytes, base64: openssl rand -base64 32
DATA_DIR=/data                       # persistent volume for state.json (the encrypted sign-in)
OWNER_EMAIL=
ALLOWED_EMAILS=                      # comma-separated, must include OWNER_EMAIL
SPREADSHEET_ID=                      # optional override; otherwise found via state file / Drive appProperties
DEFAULT_TIMEZONE=Asia/Kolkata
MAX_UPLOAD_MB=50
LOG_LEVEL=info
